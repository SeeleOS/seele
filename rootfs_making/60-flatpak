#!/bin/sh

user_exports="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"
system_exports=/var/lib/flatpak/exports/share

new_dirs=

append_dir() {
    case ":${new_dirs}:${XDG_DATA_DIRS:-}:" in
        *:"$1":*|*:"$1/":*) ;;
        *)
            if [ -n "${new_dirs}" ]; then
                new_dirs="${new_dirs}:$1"
            else
                new_dirs="$1"
            fi
            ;;
    esac
}

[ -d "$user_exports" ] && append_dir "$user_exports"
[ -d "$system_exports" ] && append_dir "$system_exports"

if [ -n "${XDG_DATA_DIRS:-}" ]; then
    if [ -n "$new_dirs" ]; then
        printf 'XDG_DATA_DIRS=%s:%s\n' "$new_dirs" "$XDG_DATA_DIRS"
    else
        printf 'XDG_DATA_DIRS=%s\n' "$XDG_DATA_DIRS"
    fi
else
    if [ -n "$new_dirs" ]; then
        printf 'XDG_DATA_DIRS=%s:/usr/local/share:/usr/share\n' "$new_dirs"
    else
        printf 'XDG_DATA_DIRS=/usr/local/share:/usr/share\n'
    fi
fi
