# Used by systemd --user instances.
#
# Seele does not implement Linux audit loginuid/session tracking yet, so
# pam_loginuid cannot be a hard requirement for the user manager.

account    include    system-login

session    optional   pam_loginuid.so
session    optional   pam_keyinit.so       force revoke
session    include    system-auth
session    optional   pam_umask.so
# Avoid logind manager-session registration here. In this guest it can block
# user@.service startup before the user manager even execs.
session    required   pam_env.so
